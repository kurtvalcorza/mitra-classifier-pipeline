    )
    code = replace_once(
        code,
        "    'features': FEATURE_COLUMNS,\n",
        "    'features': FEATURE_COLUMNS,\n    'feature_schema_sha256': feature_schema_sha256,\n",
        "main metadata schema digest",
    )
    code = replace_once(
        code,
        "    'base_model_revision': PINNED_REVISION,\n    'files': manifest_files,\n",
        "    'base_model_revision': PINNED_REVISION,\n    'feature_schema_sha256': feature_schema_sha256,\n    'files': manifest_files,\n",
        "main manifest schema digest",
    )
    set_src(export_code, code)

    reload_code = find_cell(nb, "required_reload_provenance", cell_type="code")
    code = src(reload_code)
    code = replace_once(
        code,
        "reload_metadata = json.loads(reload_metadata_path.read_text())\nrequired_reload_provenance = [\n",
        "reload_metadata = json.loads(reload_metadata_path.read_text())\nreload_features = reload_metadata.get('features')\nif (\n    not isinstance(reload_features, list)\n    or not reload_features\n    or len(reload_features) > 500\n    or any(not isinstance(name, str) or not name.strip() for name in reload_features)\n    or len(set(reload_features)) != len(reload_features)\n):\n    raise RuntimeError('Reload artifact provenance has an invalid required-feature schema.')\nreload_feature_schema_json = json.dumps(reload_features, ensure_ascii=False, separators=(',', ':'))\nreload_feature_schema_sha256 = hashlib.sha256(reload_feature_schema_json.encode('utf-8')).hexdigest()\nrequired_reload_provenance = [\n",
        "reload schema validation",
    )
    code = code.replace(
        "    'autogluon_version', 'weights_sha256', 'config_sha256', 'features',\n",
        "    'autogluon_version', 'weights_sha256', 'config_sha256', 'features', 'feature_schema_sha256',\n",
    )
    code = replace_once(
        code,
        "if reload_metadata['weights_sha256'] != EXPECTED_WEIGHTS_SHA256 or reload_metadata['config_sha256'] != EXPECTED_CONFIG_SHA256:\n    raise RuntimeError('Reload artifact provenance weight/config digests are inconsistent.')\n",
        "if reload_metadata['weights_sha256'] != EXPECTED_WEIGHTS_SHA256 or reload_metadata['config_sha256'] != EXPECTED_CONFIG_SHA256:\n    raise RuntimeError('Reload artifact provenance weight/config digests are inconsistent.')\nif reload_metadata['feature_schema_sha256'] != reload_feature_schema_sha256:\n    raise RuntimeError('Reload artifact provenance feature-schema digest is inconsistent.')\nif reload_manifest.get('feature_schema_sha256') != reload_feature_schema_sha256:\n    raise RuntimeError('Reload artifact manifest feature-schema digest is inconsistent.')\n",
        "reload schema digest checks",
    )
    code = replace_once(
        code,
        "reloaded_predictor = TabularPredictor.load(str(reload_predictor_root))\nsmoke_X = holdout_data[FEATURE_COLUMNS].head(5).copy()\n",
        "reloaded_predictor = TabularPredictor.load(str(reload_predictor_root))\nreload_feature_metadata = getattr(reloaded_predictor, 'feature_metadata_in', None)\nif reload_feature_metadata is None:\n    raise RuntimeError('Reloaded predictor exposes no input feature metadata for schema cross-check.')\nif list(reload_feature_metadata.get_features()) != reload_features:\n    raise RuntimeError('Reloaded predictor feature schema does not match the pre-deserialization provenance schema.')\nsmoke_X = holdout_data[FEATURE_COLUMNS].head(5).copy()\n",
        "reload post-load schema crosscheck",
    )
    set_src(reload_code, code)

    closing = find_cell(nb, "### Licences and provenance", cell_type="markdown")
    text = src(closing)
    text = text.replace(
        "DIMER redistributes the pinned `model.safetensors` and is not the model developer.",
        "DIMER checkpoint inputs are the pinned model files; this repository's notebook transport wrapper adds the manifest and is not a claim that DIMER natively emits that ZIP. DIMER is not the model developer.",
    )
    text = text.replace(
        "- DIMER role: distributor of the pinned `model.safetensors` artifact, not model developer",
        "- DIMER role: checkpoint source; the repository-defined notebook package wrapper adds the manifest; DIMER is not the model developer",
    )
    set_src(closing, text)

    dump_nb(MAIN_NB, nb)


def patch_inference_notebook() -> None:
    nb = json.loads(INF_NB.read_text(encoding="utf-8"))

    step2_code = find_cell(nb, "artifact_manifest = json.loads", cell_type="code")
    code = src(step2_code)
    code = replace_once(
        code,
        "if artifact_manifest.get('artifact_format') != 'dimer-mitra-autogluon-predictor' or artifact_manifest.get('artifact_format_version') != '1.0':\n    raise RuntimeError(\n        f\"Unsupported artifact manifest format/version: {artifact_manifest.get('artifact_format')!r} / {artifact_manifest.get('artifact_format_version')!r}.\"\n    )\nentries = artifact_manifest.get('files')\n",
        "if artifact_manifest.get('artifact_format') != 'dimer-mitra-autogluon-predictor' or artifact_manifest.get('artifact_format_version') != '1.0':\n    raise RuntimeError(\n        f\"Unsupported artifact manifest format/version: {artifact_manifest.get('artifact_format')!r} / {artifact_manifest.get('artifact_format_version')!r}.\"\n    )\nmanifest_feature_schema_sha256 = str(artifact_manifest.get('feature_schema_sha256', '')).lower()\nif len(manifest_feature_schema_sha256) != 64 or any(ch not in '0123456789abcdef' for ch in manifest_feature_schema_sha256):\n    raise RuntimeError('Artifact manifest is missing a valid feature_schema_sha256.')\nentries = artifact_manifest.get('files')\n",
        "inference manifest schema digest",
    )
    set_src(step2_code, code)

    step3_code = find_cell(nb, "required_provenance = [", cell_type="code")
    code = src(step3_code)
    code = replace_once(
        code,
        "    'autogluon_version',\n    'features',\n]",
        "    'autogluon_version',\n    'features',\n    'weights_sha256',\n    'config_sha256',\n    'feature_schema_sha256',\n]",
        "inference required provenance",
    )
    code = replace_once(
        code,
        "missing_provenance = [k for k in required_provenance if not run_metadata.get(k)]\nif missing_provenance:\n    raise RuntimeError(f'Predictor provenance is incomplete; missing required field(s): {missing_provenance}')\n",
        "missing_provenance = [k for k in required_provenance if not run_metadata.get(k)]\nif missing_provenance:\n    raise RuntimeError(f'Predictor provenance is incomplete; missing required field(s): {missing_provenance}')\nraw_features = run_metadata['features']\nif (\n    not isinstance(raw_features, list)\n    or not raw_features\n    or len(raw_features) > 500\n    or any(not isinstance(name, str) or not name.strip() for name in raw_features)\n    or len(set(raw_features)) != len(raw_features)\n):\n    raise RuntimeError('Predictor provenance has an invalid required-feature schema.')\nfeature_schema_json = json.dumps(raw_features, ensure_ascii=False, separators=(',', ':'))\nfeature_schema_sha256 = hashlib.sha256(feature_schema_json.encode('utf-8')).hexdigest()\nif run_metadata['feature_schema_sha256'] != feature_schema_sha256:\n    raise RuntimeError('Predictor provenance feature-schema digest does not match the declared feature list.')\nif manifest_feature_schema_sha256 != feature_schema_sha256:\n    raise RuntimeError('Artifact manifest and predictor provenance disagree on the feature schema.')\n",
        "inference schema structure checks",
    )
    old = "if run_metadata.get('features'):\n    FEATURE_COLUMNS = list(run_metadata['features'])\nelse:\n    feature_metadata = getattr(predictor, 'feature_metadata_in', None)\n    if feature_metadata is None:\n        raise RuntimeError('Could not determine required input feature columns from predictor metadata.')\n    FEATURE_COLUMNS = list(feature_metadata.get_features())\n"
    new = "FEATURE_COLUMNS = list(raw_features)\nfeature_metadata = getattr(predictor, 'feature_metadata_in', None)\nif feature_metadata is None:\n    raise RuntimeError('Loaded predictor exposes no input feature metadata for schema cross-check.')\nloaded_feature_columns = list(feature_metadata.get_features())\nif loaded_feature_columns != FEATURE_COLUMNS:\n    raise RuntimeError('Loaded predictor feature schema does not match the validated pre-deserialization provenance schema.')\n"
    code = replace_once(code, old, new, "inference post-load schema crosscheck")
    set_src(step3_code, code)

    step3_md = find_cell(nb, "## 3. Load the predictor and inspect provenance", cell_type="markdown")
    text = src(step3_md)
    text += "\nThe ordered feature-name list is structurally validated and SHA-256-bound to both provenance and the artifact manifest before deserialization; after loading, the notebook cross-checks that list against AutoGluon's own input feature metadata.\n"
    set_src(step3_md, text)

    closing = find_cell(nb, "## AI use and provenance", cell_type="markdown")
    text = src(closing)
    text = text.replace(
        "- Predictor provenance: read from `tutorial_run_metadata.json` when available",
        "- Predictor provenance: `tutorial_run_metadata.json` is required and validated before deserialization",
    )
    set_src(closing, text)

    dump_nb(INF_NB, nb)


def write_package_script() -> None:
    PACKAGE_SCRIPT.write_text('''#!/usr/bin/env python3
"""Build the repository-defined Mitra notebook transport package from a DIMER checkpoint pair.

The DIMER platform checkpoint contract remains a directory containing model.safetensors +
config.json. This script wraps those two files in the self-describing ZIP consumed by the
