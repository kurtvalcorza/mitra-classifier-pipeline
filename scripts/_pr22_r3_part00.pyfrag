        raise RuntimeError(
            f'DIMER notebook package exceeds the {MAX_DIMER_UPLOAD_BYTES / (1024 ** 2):.0f} MiB upload ceiling.'
        )
    package_path = MODEL_DIR / Path(name).name
    if package_path.suffix.lower() != '.zip':
        raise ValueError('DIMER notebook-package mode requires a .zip package with an embedded manifest.')
    package_path.write_bytes(payload)

    expected_release_files = {
        'model.safetensors': EXPECTED_WEIGHTS_SHA256,
        'config.json': EXPECTED_CONFIG_SHA256,
    }
